{
  "name": "@cds/registry",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/sync-motion-registry.mjs && node ./scripts/sync-project-registry.mjs && node ./scripts/build-registry.mjs",
    "dev": "node ./scripts/sync-motion-registry.mjs && node ./scripts/sync-project-registry.mjs && node ./scripts/build-registry.mjs && next dev --port 3001",
    "build": "node ./scripts/sync-motion-registry.mjs && node ./scripts/sync-project-registry.mjs && node ./scripts/build-registry.mjs && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "registry:build": "node ./scripts/sync-motion-registry.mjs && node ./scripts/sync-project-registry.mjs && node ./scripts/build-registry.mjs"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^3.4.0"
  },
  "devDependencies": {
    "@cds/eslint-config": "workspace:*",
    "@cds/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.22.0",
    "typescript": "^5.8.3"
  }
}
